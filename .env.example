# Crucible Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# NEVER commit the real .env file to version control.

# Google Gemini API Key (Required for live multi-agent execution)
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum Coordination Rounds (Termination Guard ceiling)
CRUCIBLE_MAX_ROUNDS=3

# Fault Injection Flag (For live robustness demo; leave empty for normal execution)
# Options: "" | "bandit" | "ast_analyzer" | "pycodestyle"
CRUCIBLE_FAULT=

# Offline / Mock Mode (Set to 1 to run tests and local demos without consuming API quotas)
CRUCIBLE_MOCK_LLM=0

# Server Configuration
HOST=0.0.0.0
PORT=8000
